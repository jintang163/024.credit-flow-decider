<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath"
             targetNamespace="http://www.bc.com/credit/process"
             id="Definitions_1">

    <process id="credit_approval_process" name="贷款审批流程" isExecutable="true" flowable:versionTag="2.0.0">

        <startEvent id="start_application" name="提交申请">
            <outgoing>Flow_to_parallel_fork</outgoing>
        </startEvent>

        <parallelGateway id="parallel_fork_gateway" name="并行开始">
            <incoming>Flow_to_parallel_fork</incoming>
            <outgoing>Flow_to_credit_query</outgoing>
            <outgoing>Flow_to_anti_fraud</outgoing>
        </parallelGateway>

        <sequenceFlow id="Flow_to_parallel_fork" sourceRef="start_application" targetRef="parallel_fork_gateway"/>

        <serviceTask id="credit_query_task" name="征信查询"
                     flowable:delegateExpression="${creditQueryDelegate}"
                     flowable:async="false">
            <incoming>Flow_to_credit_query</incoming>
            <outgoing>Flow_to_parallel_join</outgoing>
        </serviceTask>

        <sequenceFlow id="Flow_to_credit_query" sourceRef="parallel_fork_gateway" targetRef="credit_query_task"/>

        <serviceTask id="anti_fraud_task" name="反欺诈校验"
                     flowable:delegateExpression="${antiFraudDelegate}"
                     flowable:async="false">
            <incoming>Flow_to_anti_fraud</incoming>
            <outgoing>Flow_to_parallel_join</outgoing>
        </serviceTask>

        <sequenceFlow id="Flow_to_anti_fraud" sourceRef="parallel_fork_gateway" targetRef="anti_fraud_task"/>

        <parallelGateway id="parallel_join_gateway" name="并行汇聚">
            <incoming>Flow_to_parallel_join</incoming>
            <incoming>Flow_to_parallel_join</incoming>
            <outgoing>Flow_to_precheck_gateway</outgoing>
        </parallelGateway>

        <sequenceFlow id="Flow_to_parallel_join" sourceRef="credit_query_task" targetRef="parallel_join_gateway"/>
        <sequenceFlow id="Flow_to_parallel_join_2" sourceRef="anti_fraud_task" targetRef="parallel_join_gateway"/>

        <exclusiveGateway id="precheck_gateway" name="前置校验">
            <incoming>Flow_to_precheck_gateway</incoming>
            <outgoing>Flow_precheck_fraud_reject</outgoing>
            <outgoing>Flow_precheck_credit_reject</outgoing>
            <outgoing>Flow_to_scoring</outgoing>
        </exclusiveGateway>

        <sequenceFlow id="Flow_to_precheck_gateway" sourceRef="parallel_join_gateway" targetRef="precheck_gateway"/>

        <sequenceFlow id="Flow_precheck_fraud_reject" name="欺诈拒绝"
                      sourceRef="precheck_gateway" targetRef="end_rejected">
            <conditionExpression xsi:type="tFormalExpression">
                <![CDATA[${fraudResult == 2}]]>
            </conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="Flow_precheck_credit_reject" name="征信不足拒绝"
                      sourceRef="precheck_gateway" targetRef="end_rejected">
            <conditionExpression xsi:type="tFormalExpression">
                <![CDATA[${creditScore < 500}]]>
            </conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="Flow_to_scoring" name="继续审批"
                      sourceRef="precheck_gateway" targetRef="credit_scoring_task">
            <conditionExpression xsi:type="tFormalExpression">
                <![CDATA[${fraudResult != 2 && creditScore >= 500}]]>
            </conditionExpression>
        </sequenceFlow>

        <serviceTask id="credit_scoring_task" name="信用评分"
                     flowable:delegateExpression="${creditScoringDelegate}">
            <incoming>Flow_to_scoring</incoming>
            <outgoing>Flow_to_score_gateway</outgoing>
        </serviceTask>

        <exclusiveGateway id="score_gateway" name="评分结果判断">
            <incoming>Flow_to_score_gateway</incoming>
            <outgoing>Flow_score_reject</outgoing>
            <outgoing>Flow_to_limit_calc</outgoing>
        </exclusiveGateway>

        <sequenceFlow id="Flow_to_score_gateway" sourceRef="credit_scoring_task" targetRef="score_gateway"/>

        <sequenceFlow id="Flow_score_reject" name="评分不足拒绝"
                      sourceRef="score_gateway" targetRef="end_rejected">
            <conditionExpression xsi:type="tFormalExpression">
                <![CDATA[${creditScore < 600}]]>
            </conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="Flow_to_limit_calc" name="评分通过"
                      sourceRef="score_gateway" targetRef="limit_calc_task">
            <conditionExpression xsi:type="tFormalExpression">
                <![CDATA[${creditScore >= 600}]]>
            </conditionExpression>
        </sequenceFlow>

        <serviceTask id="limit_calc_task" name="额度计算"
                     flowable:delegateExpression="${limitCalculationDelegate}">
            <incoming>Flow_to_limit_calc</incoming>
            <outgoing>Flow_to_review_gateway</outgoing>
        </serviceTask>

        <exclusiveGateway id="review_gateway" name="复核判断">
            <incoming>Flow_to_review_gateway</incoming>
            <outgoing>Flow_manual_review</outgoing>
            <outgoing>Flow_to_final_approval</outgoing>
            <outgoing>Flow_high_risk_reject</outgoing>
        </exclusiveGateway>

        <sequenceFlow id="Flow_to_review_gateway" sourceRef="limit_calc_task" targetRef="review_gateway"/>

        <sequenceFlow id="Flow_manual_review" name="需人工复核"
                      sourceRef="review_gateway" targetRef="manual_review_task">
            <conditionExpression xsi:type="tFormalExpression">
                <![CDATA[${needManualReview == true || loanAmount >= 200000}]]>
            </conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="Flow_high_risk_reject" name="高风险拒绝"
                      sourceRef="review_gateway" targetRef="end_rejected">
            <conditionExpression xsi:type="tFormalExpression">
                <![CDATA[${riskLevel == 'HIGH' && fraudResult == 1}]]>
            </conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="Flow_to_final_approval" name="直接终审"
                      sourceRef="review_gateway" targetRef="final_approval_task">
            <conditionExpression xsi:type="tFormalExpression">
                <![CDATA[${needManualReview == false && loanAmount < 200000 && (riskLevel != 'HIGH' || fraudResult == 0)}]]>
            </conditionExpression>
        </sequenceFlow>

        <userTask id="manual_review_task" name="人工复核"
                  flowable:candidateGroups="MANAGER"
                  flowable:formKey="manualReviewForm">
            <extensionElements>
                <flowable:taskListener event="create" delegateExpression="${taskCreateListener}"/>
                <flowable:taskListener event="complete" delegateExpression="${taskCompleteListener}"/>
            </extensionElements>
            <incoming>Flow_manual_review</incoming>
            <incoming>Flow_reject_to_manual_review</incoming>
            <outgoing>Flow_manual_review_gateway</outgoing>
        </userTask>

        <exclusiveGateway id="manual_review_gateway" name="复核结果">
            <incoming>Flow_manual_review_gateway</incoming>
            <outgoing>Flow_review_reject</outgoing>
            <outgoing>Flow_review_to_final</outgoing>
            <outgoing>Flow_review_return</outgoing>
        </exclusiveGateway>

        <sequenceFlow id="Flow_manual_review_gateway" sourceRef="manual_review_task" targetRef="manual_review_gateway"/>

        <sequenceFlow id="Flow_review_reject" name="复核拒绝"
                      sourceRef="manual_review_gateway" targetRef="end_rejected">
            <conditionExpression xsi:type="tFormalExpression">
                <![CDATA[${manualReviewResult == 'REJECT'}]]>
            </conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="Flow_review_to_final" name="复核通过"
                      sourceRef="manual_review_gateway" targetRef="final_approval_task">
            <conditionExpression xsi:type="tFormalExpression">
                <![CDATA[${manualReviewResult == 'PASS'}]]>
            </conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="Flow_review_return" name="退回补件"
                      sourceRef="manual_review_gateway" targetRef="return_to_submit_gateway">
            <conditionExpression xsi:type="tFormalExpression">
                <![CDATA[${manualReviewResult == 'RETURN'}]]>
            </conditionExpression>
        </sequenceFlow>

        <userTask id="final_approval_task" name="终审"
                  flowable:candidateGroups="SENIOR_MANAGER"
                  flowable:formKey="finalApprovalForm">
            <extensionElements>
                <flowable:taskListener event="create" delegateExpression="${taskCreateListener}"/>
                <flowable:taskListener event="complete" delegateExpression="${taskCompleteListener}"/>
            </extensionElements>
            <incoming>Flow_to_final_approval</incoming>
            <incoming>Flow_review_to_final</incoming>
            <outgoing>Flow_final_gateway</outgoing>
        </userTask>

        <exclusiveGateway id="final_gateway" name="终审结果">
            <incoming>Flow_final_gateway</incoming>
            <outgoing>Flow_final_reject</outgoing>
            <outgoing>Flow_final_approve</outgoing>
            <outgoing>Flow_final_return</outgoing>
        </exclusiveGateway>

        <sequenceFlow id="Flow_final_gateway" sourceRef="final_approval_task" targetRef="final_gateway"/>

        <sequenceFlow id="Flow_final_reject" name="终审拒绝"
                      sourceRef="final_gateway" targetRef="end_rejected">
            <conditionExpression xsi:type="tFormalExpression">
                <![CDATA[${finalApprovalResult == 'REJECT'}]]>
            </conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="Flow_final_approve" name="终审通过"
                      sourceRef="final_gateway" targetRef="approval_notification_task">
            <conditionExpression xsi:type="tFormalExpression">
                <![CDATA[${finalApprovalResult == 'PASS'}]]>
            </conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="Flow_final_return" name="终审退回"
                      sourceRef="final_gateway" targetRef="return_to_review_gateway">
            <conditionExpression xsi:type="tFormalExpression">
                <![CDATA[${finalApprovalResult == 'RETURN'}]]>
            </conditionExpression>
        </sequenceFlow>

        <exclusiveGateway id="return_to_review_gateway" name="退回复核">
            <incoming>Flow_final_return</incoming>
            <outgoing>Flow_reject_to_manual_review</outgoing>
        </exclusiveGateway>

        <sequenceFlow id="Flow_reject_to_manual_review" sourceRef="return_to_review_gateway" targetRef="manual_review_task"/>

        <exclusiveGateway id="return_to_submit_gateway" name="退回提交">
            <incoming>Flow_review_return</incoming>
            <outgoing>Flow_to_rework</outgoing>
        </exclusiveGateway>

        <userTask id="rework_task" name="补充资料"
                  flowable:assignee="${applyUser}"
                  flowable:formKey="reworkForm">
            <extensionElements>
                <flowable:taskListener event="create" delegateExpression="${taskCreateListener}"/>
                <flowable:taskListener event="complete" delegateExpression="${taskCompleteListener}"/>
            </extensionElements>
            <incoming>Flow_to_rework</incoming>
            <outgoing>Flow_rework_to_parallel_fork</outgoing>
        </userTask>

        <sequenceFlow id="Flow_to_rework" sourceRef="return_to_submit_gateway" targetRef="rework_task"/>
        <sequenceFlow id="Flow_rework_to_parallel_fork" sourceRef="rework_task" targetRef="parallel_fork_gateway"/>

        <serviceTask id="approval_notification_task" name="审批通过通知"
                     flowable:delegateExpression="${approvalNotificationDelegate}">
            <incoming>Flow_final_approve</incoming>
            <outgoing>Flow_to_approved_end</outgoing>
        </serviceTask>

        <sequenceFlow id="Flow_to_approved_end" sourceRef="approval_notification_task" targetRef="end_approved"/>

        <endEvent id="end_approved" name="审批通过">
            <incoming>Flow_to_approved_end</incoming>
        </endEvent>

        <endEvent id="end_rejected" name="审批拒绝">
            <incoming>Flow_precheck_fraud_reject</incoming>
            <incoming>Flow_precheck_credit_reject</incoming>
            <incoming>Flow_score_reject</incoming>
            <incoming>Flow_review_reject</incoming>
            <incoming>Flow_final_reject</incoming>
            <incoming>Flow_high_risk_reject</incoming>
        </endEvent>

    </process>

